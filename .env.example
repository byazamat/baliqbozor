# Скопируйте в .env: cp .env.example .env
# SPEC 13.6 + DECISIONS D-10. Секреты — только через окружение.

# общие
NODE_ENV=development
APP_ENV=local                  # local | staging | production
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000
# лимит запросов на пользователя/IP в минуту (SPEC 10.1), 0 — выключен
RATE_LIMIT_PER_MINUTE=100
# сколько reverse proxy перед API (для реального IP клиента)
TRUST_PROXY_HOPS=0
WORKER_HEALTH_PORT=4010
# Worker: интервал heartbeat-задачи и опрос outbox (D-23)
HEARTBEAT_INTERVAL_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
BRAND_NAME=BaliqBozor
APP_DEEPLINK_SCHEME=baliqbozor

# база и очереди
DATABASE_URL=postgresql://app:app@localhost:5432/baliqbozor
# e2e используют отдельную БД <имя>_test и Redis /1 (создаются автоматически); можно задать явно:
# DATABASE_URL_TEST=postgresql://app:app@localhost:5432/baliqbozor_test
REDIS_URL=redis://localhost:6379

# auth
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_SECRET_PREVIOUS=    # предыдущий ключ на время ротации
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
OTP_DEV_BYPASS_CODE=000000     # работает только при APP_ENV=local

# S3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000   # адрес для presigned URL из браузера
S3_REGION=us-east-1
S3_BUCKET=baliqbozor-private
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# SMS
SMS_PROVIDER=console           # console | eskiz
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_SENDER=4546
SMS_STAGING_WHITELIST=+998901234567

# push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_CALLBACK_HMAC_SECRET=

# наблюдаемость
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_ADMIN=
SENTRY_DSN_MOBILE=
LOG_LEVEL=info

# клиенты: Next.js встраивает NEXT_PUBLIC_* при сборке
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BRAND_NAME=BaliqBozor

# платформа (реквизиты для счетов на комиссию)
PLATFORM_LEGAL_NAME=
PLATFORM_TIN=
PLATFORM_BANK_DETAILS=
