{
  "extends": "@baliqbozor/config/tsconfig/next.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.ts",
    "e2e"
  ],
  "exclude": ["node_modules", ".next"]
}
