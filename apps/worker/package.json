{
  "name": "@baliqbozor/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --config jest.config.js --passWithNoTests",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@baliqbozor/db": "workspace:*",
    "@baliqbozor/domain": "workspace:*",
    "@baliqbozor/i18n": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "bullmq": "6.5.3",
    "ffmpeg-static": "5.3.0",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@baliqbozor/config": "workspace:*",
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
