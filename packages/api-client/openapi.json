{
  "components": {
    "schemas": {
      "ApiErrorBodyDto": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "example": "Недостаточно доступного объёма",
            "type": "string"
          },
          "requestId": {
            "example": "b7c1f0e2-…",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      },
      "ApiErrorDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AuthUserDto": {
        "properties": {
          "fullName": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "phone": {
            "example": "+998901234567",
            "type": "string"
          },
          "platformRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlatformRole"
              }
            ]
          }
        },
        "required": [
          "id",
          "phone",
          "fullName",
          "locale",
          "platformRole"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "INVALID_TRANSITION",
          "INSUFFICIENT_VOLUME",
          "ORG_NOT_VERIFIED",
          "ORG_SUSPENDED",
          "OTP_INVALID",
          "OTP_EXPIRED",
          "OTP_TOO_MANY_ATTEMPTS",
          "RATE_LIMITED",
          "COMMISSION_OVERDUE_BLOCK",
          "MEDIA_TOO_LARGE",
          "MEDIA_TYPE_NOT_ALLOWED",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "HealthDto": {
        "properties": {
          "service": {
            "example": "api",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "type": "string"
          },
          "uptimeSec": {
            "example": 42,
            "type": "number"
          }
        },
        "required": [
          "status",
          "service",
          "uptimeSec",
          "time"
        ],
        "type": "object"
      },
      "Locale": {
        "enum": [
          "uz",
          "ru"
        ],
        "type": "string"
      },
      "LoginResultDto": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "description": "Срок жизни access-токена, с",
            "example": 900,
            "type": "number"
          },
          "isNewUser": {
            "description": "Пользователь создан этим входом — нужен онбординг",
            "type": "boolean"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresIn",
          "user",
          "isNewUser"
        ],
        "type": "object"
      },
      "OtpRequestDto": {
        "properties": {
          "phone": {
            "description": "Номер Узбекистана; принимаются пробелы, скобки, дефисы",
            "example": "+998901234567",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "type": "object"
      },
      "OtpRequestResultDto": {
        "properties": {
          "resendAfterSec": {
            "description": "Через сколько секунд можно запросить код снова",
            "example": 60,
            "type": "number"
          }
        },
        "required": [
          "resendAfterSec"
        ],
        "type": "object"
      },
      "OtpVerifyDto": {
        "properties": {
          "code": {
            "example": "123456",
            "type": "string"
          },
          "phone": {
            "description": "Номер Узбекистана; принимаются пробелы, скобки, дефисы",
            "example": "+998901234567",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "code"
        ],
        "type": "object"
      },
      "PlatformRole": {
        "enum": [
          "USER",
          "OPERATOR",
          "ADMIN"
        ],
        "type": "string"
      },
      "ReadinessCheckDto": {
        "properties": {
          "error": {
            "example": "timeout",
            "type": "string"
          },
          "latencyMs": {
            "example": 3,
            "type": "number"
          },
          "status": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "type": "object"
      },
      "ReadinessChecksDto": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/ReadinessCheckDto"
          },
          "redis": {
            "$ref": "#/components/schemas/ReadinessCheckDto"
          },
          "storage": {
            "$ref": "#/components/schemas/ReadinessCheckDto"
          }
        },
        "required": [
          "database",
          "redis",
          "storage"
        ],
        "type": "object"
      },
      "ReadinessDto": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "RefreshDto": {
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "TokenPairDto": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "description": "Срок жизни access-токена, с",
            "example": 900,
            "type": "number"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresIn"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "BaliqBozor API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "Auth_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/otp/request": {
      "post": {
        "operationId": "Auth_requestOtp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestResultDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            },
            "description": "VALIDATION_FAILED"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            },
            "description": "RATE_LIMITED (details.retryAfterSec)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "operationId": "Auth_verifyOtp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResultDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            },
            "description": "OTP_INVALID, OTP_EXPIRED, VALIDATION_FAILED"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            },
            "description": "OTP_TOO_MANY_ATTEMPTS"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "Auth_refresh",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "Health_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            },
            "description": "Процесс жив"
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "Health_getReady",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            },
            "description": "БД, Redis и S3 доступны"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            },
            "description": "Одна из зависимостей недоступна"
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
