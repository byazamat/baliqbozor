{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["packages/config/tsconfig/*.json"],
  "globalEnv": ["NODE_ENV", "APP_ENV"],
  "envMode": "loose",
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**", ".next/types/**", "next-env.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    }
  }
}
